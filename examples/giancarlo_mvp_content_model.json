      "type": "flashcard",
      "order": 4,
      "estimated_duration_minutes": 2,
      "linked_episode_numbers": [8],
      "content": {
        "flashcard_front": "Was sagt das Ohmsche Gesetz?",
        "flashcard_back": "U = R × I\nSpannung = Widerstand × Strom\n\nBei konstantem Widerstand steigt die Spannung proportional zum Strom."
      },
