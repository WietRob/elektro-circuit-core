{
  "$schema": "../schemas/ontology.json",
  "circuitId": "zeitverzoegerung",
  "version": "2.1.0",

  "topology": {
    "serial_gate": {
      "device": "S1",
      "role": "Start-Taster"
    },
    "split": {
      "after": "S1",
      "branches": [
        {
          "id": "direct_branch",
          "device": "K1-AUX-S",
          "role": "Sofortschaltend",
          "type": "immediate"
        },
        {
          "id": "timer_branch",
          "device": "K1-AUX-V",
          "role": "Zeitverzoegert",
          "type": "delayed"
        }
      ]
    },
    "merge": {
      "before": "P1",
      "sources": ["K1-AUX-S", "K1-AUX-V"]
    }
  },

  "components": {
    "S1": {
      "id": "S1",
      "type": "pushbutton",
      "label": "S1 Start",
      "parts": {
        "S1-BUTTON": {
          "id": "S1-BUTTON",
          "type": "button_mechanism",
          "terminals": {
            "13": { "id": "13", "function": "input", "potential": "L" },
            "14": { "id": "14", "function": "output", "potential": "control" }
          }
        }
      }
    },

    "K1": {
      "id": "K1",
      "type": "timer_relay",
      "label": "K1 Zeitrelais",
      "parts": {
        "K1-COIL": {
          "id": "K1-COIL",
          "type": "timer_coil",
          "terminals": {
            "A1": { "id": "A1", "function": "coil_in", "potential": "control" },
            "A2": { "id": "A2", "function": "coil_out", "potential": "N" }
          }
        },
        "K1-AUX-S": {
          "id": "K1-AUX-S",
          "type": "timer_contact_s",
          "label": "S",
          "terminals": {
            "13": { "id": "13", "function": "contact_in", "potential": "L" },
            "14": { "id": "14", "function": "contact_out", "potential": "load1" }
          },
          "mechanicallyCoupledTo": "K1-COIL.ANKER"
        },
        "K1-AUX-V": {
          "id": "K1-AUX-V",
          "type": "timer_contact_v",
          "label": "V",
          "terminals": {
            "13": { "id": "13", "function": "contact_in", "potential": "L" },
            "14": { "id": "14", "function": "contact_out", "potential": "load2" }
          },
          "mechanicallyCoupledTo": "K1-COIL.ANKER"
        }
      }
    },

    "P1": {
      "id": "P1",
      "type": "lamp",
      "label": "P1 Lampe (Sofort)",
      "parts": {
        "P1-LAMP": {
          "id": "P1-LAMP",
          "type": "lamp_element",
          "terminals": {
            "IN": { "id": "IN", "function": "input", "potential": "load1" },
            "OUT": { "id": "OUT", "function": "output", "potential": "N" }
          }
        }
      }
    },

    "P2": {
      "id": "P2",
      "type": "lamp",
      "label": "P2 Lampe (Verzoegert)",
      "parts": {
        "P2-LAMP": {
          "id": "P2-LAMP",
          "type": "lamp_element",
          "terminals": {
            "IN": { "id": "IN", "function": "input", "potential": "load2" },
            "OUT": { "id": "OUT", "function": "output", "potential": "N" }
          }
        }
      }
    }
  },

  "anchors": {
    "DIN-S1-BUTTON-13": { "id": "DIN-S1-BUTTON-13", "view": "DIN", "component": "S1", "part": "S1-BUTTON", "terminal": "13", "x": 100, "y": 80 },
    "DIN-S1-BUTTON-14": { "id": "DIN-S1-BUTTON-14", "view": "DIN", "component": "S1", "part": "S1-BUTTON", "terminal": "14", "x": 100, "y": 105 },
    "DIN-K1-COIL-A1": { "id": "DIN-K1-COIL-A1", "view": "DIN", "component": "K1", "part": "K1-COIL", "terminal": "A1", "x": 200, "y": 180 },
    "DIN-K1-COIL-A2": { "id": "DIN-K1-COIL-A2", "view": "DIN", "component": "K1", "part": "K1-COIL", "terminal": "A2", "x": 200, "y": 205 },
    "DIN-K1-AUX-S-13": { "id": "DIN-K1-AUX-S-13", "view": "DIN", "component": "K1", "part": "K1-AUX-S", "terminal": "13", "x": 300, "y": 80 },
    "DIN-K1-AUX-S-14": { "id": "DIN-K1-AUX-S-14", "view": "DIN", "component": "K1", "part": "K1-AUX-S", "terminal": "14", "x": 300, "y": 105 },
    "DIN-K1-AUX-V-13": { "id": "DIN-K1-AUX-V-13", "view": "DIN", "component": "K1", "part": "K1-AUX-V", "terminal": "13", "x": 400, "y": 80 },
    "DIN-K1-AUX-V-14": { "id": "DIN-K1-AUX-V-14", "view": "DIN", "component": "K1", "part": "K1-AUX-V", "terminal": "14", "x": 400, "y": 105 },
    "DIN-P1-LAMP-IN": { "id": "DIN-P1-LAMP-IN", "view": "DIN", "component": "P1", "part": "P1-LAMP", "terminal": "IN", "x": 300, "y": 180 },
    "DIN-P1-LAMP-OUT": { "id": "DIN-P1-LAMP-OUT", "view": "DIN", "component": "P1", "part": "P1-LAMP", "terminal": "OUT", "x": 300, "y": 205 },
    "DIN-P2-LAMP-IN": { "id": "DIN-P2-LAMP-IN", "view": "DIN", "component": "P2", "part": "P2-LAMP", "terminal": "IN", "x": 400, "y": 180 },
    "DIN-P2-LAMP-OUT": { "id": "DIN-P2-LAMP-OUT", "view": "DIN", "component": "P2", "part": "P2-LAMP", "terminal": "OUT", "x": 400, "y": 205 },
    "DIN-RAIL-L": { "id": "DIN-RAIL-L", "view": "DIN", "component": "RAIL", "part": "L", "terminal": "L", "x": 100, "y": 40 },
    "DIN-RAIL-N": { "id": "DIN-RAIL-N", "view": "DIN", "component": "RAIL", "part": "N", "terminal": "N", "x": 400, "y": 250 },

    "LAB-S1-BUTTON-13": { "id": "LAB-S1-BUTTON-13", "view": "LAB", "component": "S1", "part": "S1-BUTTON", "terminal": "13", "x": 80, "y": 55 },
    "LAB-S1-BUTTON-14": { "id": "LAB-S1-BUTTON-14", "view": "LAB", "component": "S1", "part": "S1-BUTTON", "terminal": "14", "x": 80, "y": 80 },
    "LAB-K1-COIL-A1": { "id": "LAB-K1-COIL-A1", "view": "LAB", "component": "K1", "part": "K1-COIL", "terminal": "A1", "x": 155, "y": 130 },
    "LAB-K1-COIL-A2": { "id": "LAB-K1-COIL-A2", "view": "LAB", "component": "K1", "part": "K1-COIL", "terminal": "A2", "x": 195, "y": 130 },
    "LAB-K1-AUX-S-13": { "id": "LAB-K1-AUX-S-13", "view": "LAB", "component": "K1", "part": "K1-AUX-S", "terminal": "13", "x": 155, "y": 55 },
    "LAB-K1-AUX-S-14": { "id": "LAB-K1-AUX-S-14", "view": "LAB", "component": "K1", "part": "K1-AUX-S", "terminal": "14", "x": 195, "y": 80 },
    "LAB-K1-AUX-V-13": { "id": "LAB-K1-AUX-V-13", "view": "LAB", "component": "K1", "part": "K1-AUX-V", "terminal": "13", "x": 155, "y": 100 },
    "LAB-K1-AUX-V-14": { "id": "LAB-K1-AUX-V-14", "view": "LAB", "component": "K1", "part": "K1-AUX-V", "terminal": "14", "x": 195, "y": 155 },
    "LAB-P1-LAMP-IN": { "id": "LAB-P1-LAMP-IN", "view": "LAB", "component": "P1", "part": "P1-LAMP", "terminal": "IN", "x": 348, "y": 220 },
    "LAB-P1-LAMP-OUT": { "id": "LAB-P1-LAMP-OUT", "view": "LAB", "component": "P1", "part": "P1-LAMP", "terminal": "OUT", "x": 372, "y": 220 },
    "LAB-P2-LAMP-IN": { "id": "LAB-P2-LAMP-IN", "view": "LAB", "component": "P2", "part": "P2-LAMP", "terminal": "IN", "x": 348, "y": 270 },
    "LAB-P2-LAMP-OUT": { "id": "LAB-P2-LAMP-OUT", "view": "LAB", "component": "P2", "part": "P2-LAMP", "terminal": "OUT", "x": 372, "y": 270 },
    "LAB-RAIL-L": { "id": "LAB-RAIL-L", "view": "LAB", "component": "RAIL", "part": "L", "terminal": "L", "x": 80, "y": 25 },
    "LAB-RAIL-N": { "id": "LAB-RAIL-N", "view": "LAB", "component": "RAIL", "part": "N", "terminal": "N", "x": 175, "y": 300 }
  },

  "wires": [
    { "id": "din-wire-l-s1", "fromAnchor": "DIN-RAIL-L", "toAnchor": "DIN-S1-BUTTON-13", "type": "control", "route": [{"x": 100, "y": 40}, {"x": 100, "y": 80}] },
    { "id": "din-wire-s1-k1", "fromAnchor": "DIN-S1-BUTTON-14", "toAnchor": "DIN-K1-COIL-A1", "type": "control", "route": [{"x": 100, "y": 105}, {"x": 100, "y": 180}, {"x": 200, "y": 180}] },
    { "id": "din-wire-k1-n", "fromAnchor": "DIN-K1-COIL-A2", "toAnchor": "DIN-RAIL-N", "type": "control", "route": [{"x": 200, "y": 205}, {"x": 200, "y": 250}, {"x": 400, "y": 250}] },
    { "id": "din-wire-l-s", "fromAnchor": "DIN-RAIL-L", "toAnchor": "DIN-K1-AUX-S-13", "type": "load", "route": [{"x": 300, "y": 40}, {"x": 300, "y": 80}] },
    { "id": "din-wire-s-p1", "fromAnchor": "DIN-K1-AUX-S-14", "toAnchor": "DIN-P1-LAMP-IN", "type": "load", "route": [{"x": 300, "y": 105}, {"x": 300, "y": 180}] },
    { "id": "din-wire-p1-n", "fromAnchor": "DIN-P1-LAMP-OUT", "toAnchor": "DIN-RAIL-N", "type": "load", "route": [{"x": 300, "y": 205}, {"x": 300, "y": 250}, {"x": 400, "y": 250}] },
    { "id": "din-wire-l-v", "fromAnchor": "DIN-RAIL-L", "toAnchor": "DIN-K1-AUX-V-13", "type": "load", "route": [{"x": 400, "y": 40}, {"x": 400, "y": 80}] },
    { "id": "din-wire-v-p2", "fromAnchor": "DIN-K1-AUX-V-14", "toAnchor": "DIN-P2-LAMP-IN", "type": "load", "route": [{"x": 400, "y": 105}, {"x": 400, "y": 180}] },
    { "id": "din-wire-p2-n", "fromAnchor": "DIN-P2-LAMP-OUT", "toAnchor": "DIN-RAIL-N", "type": "load", "route": [{"x": 400, "y": 205}, {"x": 400, "y": 250}] },

    { "id": "lab-wire-l-s1", "fromAnchor": "LAB-RAIL-L", "toAnchor": "LAB-S1-BUTTON-13", "type": "control", "color": "#1976d2", "route": [{"x": 80, "y": 25}, {"x": 80, "y": 55}] },
    { "id": "lab-wire-s1-k1", "fromAnchor": "LAB-S1-BUTTON-14", "toAnchor": "LAB-K1-COIL-A1", "type": "control", "color": "#1976d2", "route": [{"x": 80, "y": 80}, {"x": 80, "y": 130}, {"x": 155, "y": 130}] },
    { "id": "lab-wire-k1-n", "fromAnchor": "LAB-K1-COIL-A2", "toAnchor": "LAB-RAIL-N", "type": "control", "color": "#1976d2", "route": [{"x": 195, "y": 130}, {"x": 195, "y": 300}] },
    { "id": "lab-wire-l-s", "fromAnchor": "LAB-RAIL-L", "toAnchor": "LAB-K1-AUX-S-13", "type": "preinstalled", "color": "#607d8b", "route": [{"x": 200, "y": 25}, {"x": 200, "y": 55}] },
    { "id": "lab-wire-s-p1", "fromAnchor": "LAB-K1-AUX-S-14", "toAnchor": "LAB-P1-LAMP-IN", "type": "load", "color": "#1976d2", "route": [{"x": 195, "y": 80}, {"x": 195, "y": 170}, {"x": 348, "y": 170}, {"x": 348, "y": 220}] },
    { "id": "lab-wire-p1-n", "fromAnchor": "LAB-P1-LAMP-OUT", "toAnchor": "LAB-RAIL-N", "type": "preinstalled", "color": "#607d8b", "route": [{"x": 372, "y": 220}, {"x": 372, "y": 300}] },
    { "id": "lab-wire-l-v", "fromAnchor": "LAB-RAIL-L", "toAnchor": "LAB-K1-AUX-V-13", "type": "preinstalled", "color": "#607d8b", "route": [{"x": 250, "y": 25}, {"x": 250, "y": 100}] },
    { "id": "lab-wire-v-p2", "fromAnchor": "LAB-K1-AUX-V-14", "toAnchor": "LAB-P2-LAMP-IN", "type": "load", "color": "#1976d2", "route": [{"x": 195, "y": 155}, {"x": 195, "y": 270}, {"x": 348, "y": 270}] },
    { "id": "lab-wire-p2-n", "fromAnchor": "LAB-P2-LAMP-OUT", "toAnchor": "LAB-RAIL-N", "type": "preinstalled", "color": "#607d8b", "route": [{"x": 372, "y": 270}, {"x": 372, "y": 300}] }
  ],

  "states": {
    "initial": {
      "id": "initial",
      "initial": true,
      "transitions": [
        { "trigger": "S1.pressed", "target": "active", "actions": { "S1.closed": true, "K1-COIL.active": true, "K1-AUX-S.closed": true } }
      ],
      "expected": {
        "wireCurrentCount": 0,
        "activePaths": [],
        "componentStates": {
          "S1": "open",
          "K1-COIL": "inactive",
          "K1-AUX-S": "open",
          "K1-AUX-V": "open",
          "P1": "dark",
          "P2": "dark"
        }
      }
    },
    "active": {
      "id": "active",
      "initial": false,
      "transitions": [
        { "trigger": "timer.expired", "target": "delayed", "actions": { "K1-AUX-V.closed": true } }
      ],
      "expected": {
        "wireCurrentCount": 10,
        "activePaths": ["immediate_path"],
        "componentStates": {
          "S1": "open",
          "K1-COIL": "active",
          "K1-AUX-S": "closed",
          "K1-AUX-V": "open",
          "P1": "lit",
          "P2": "dark"
        }
      }
    },
    "delayed": {
      "id": "delayed",
      "initial": false,
      "transitions": [
        { "trigger": "S1.pressed", "target": "reset", "actions": { "S1.closed": true } }
      ],
      "expected": {
        "wireCurrentCount": 20,
        "activePaths": ["immediate_path", "delayed_path"],
        "componentStates": {
          "S1": "open",
          "K1-COIL": "active",
          "K1-AUX-S": "closed",
          "K1-AUX-V": "closed",
          "P1": "lit",
          "P2": "lit"
        }
      }
    },
    "reset": {
      "id": "reset",
      "initial": false,
      "transitions": [
        { "trigger": "S1.released", "target": "initial", "actions": { "S1.closed": true } }
      ],
      "expected": {
        "wireCurrentCount": 0,
        "activePaths": [],
        "componentStates": {
          "S1": "open",
          "K1-COIL": "inactive",
          "K1-AUX-S": "open",
          "K1-AUX-V": "open",
          "P1": "dark",
          "P2": "dark"
        }
      }
    }
  },

  "transferMappings": [
    { "dinComponent": "DIN-S1-BUTTON", "laborTarget": { "component": "LAB-S1-BUTTON", "highlight": "component" }, "bidirectional": true },
    { "dinComponent": "DIN-K1-COIL", "laborTarget": { "component": "LAB-K1-COIL", "highlight": "component" }, "bidirectional": true },
    { "dinComponent": "DIN-K1-AUX-S", "laborTarget": { "component": "LAB-K1-AUX-S", "highlight": "component" }, "bidirectional": true },
    { "dinComponent": "DIN-K1-AUX-V", "laborTarget": { "component": "LAB-K1-AUX-V", "highlight": "component" }, "bidirectional": true },
    { "dinComponent": "DIN-P1-LAMP", "laborTarget": { "component": "LAB-P1-LAMP", "highlight": "component" }, "bidirectional": true },
    { "dinComponent": "DIN-P2-LAMP", "laborTarget": { "component": "LAB-P2-LAMP", "highlight": "component" }, "bidirectional": true }
  ],

  "logic": {
    "S1.closed": "states.active",
    "K1-COIL.active": "S1.closed",
    "K1-COIL.ANKER.attracted": "K1-COIL.active",
    "K1-AUX-S.closed": "K1-COIL.ANKER.attracted",
    "K1-AUX-V.closed": "K1-COIL.ANKER.attracted AND timer.expired",
    "P1.lit": "K1-AUX-S.closed",
    "P2.lit": "K1-AUX-V.closed"
  },

  "currentPaths": [
    {
      "id": "control_path",
      "label": "Steuerpfad",
      "role": "control",
      "description": "S1 schaltet K1-COIL ein",
      "activeWhen": "K1-COIL.active",
      "wires": ["din-wire-l-s1", "din-wire-s1-k1", "din-wire-k1-n"],
      "potentialFlow": "L -> S1.13 -> S1.14 -> K1.A1 -> K1.COIL -> K1.A2 -> N"
    },
    {
      "id": "immediate_path",
      "label": "Sofortpfad (S)",
      "role": "effect",
      "description": "Sofortschaltender Kontakt schliesst sofort",
      "activeWhen": "K1-AUX-S.closed",
      "wires": ["din-wire-l-s", "din-wire-s-p1", "din-wire-p1-n"],
      "potentialFlow": "L -> K1-S.13 -> K1-S.14 -> P1.IN -> P1 -> P1.OUT -> N"
    },
    {
      "id": "delayed_path",
      "label": "Verzoegerungspfad (V)",
      "role": "effect",
      "description": "Verzoegert schliessender Kontakt schliesst nach Zeitablauf",
      "activeWhen": "K1-AUX-V.closed",
      "wires": ["din-wire-l-v", "din-wire-v-p2", "din-wire-p2-n"],
      "potentialFlow": "L -> K1-V.13 -> K1-V.14 -> P2.IN -> P2 -> P2.OUT -> N"
    }
  ],

  "didactic": {
    "functions": [
      {
        "id": "overview",
        "title": "Ueberblick",
        "goal": "Zeitverzoegerte Schaltung mit Zeitrelais verstehen",
        "paths": [],
        "focus": {
          "din": ["DIN-S1-BUTTON", "DIN-K1-COIL", "DIN-K1-AUX-S", "DIN-K1-AUX-V", "DIN-P1-LAMP", "DIN-P2-LAMP"],
          "lab": ["LAB-S1-BUTTON", "LAB-K1-COIL", "LAB-K1-AUX-S", "LAB-K1-AUX-V", "LAB-P1-LAMP", "LAB-P2-LAMP"]
        },
        "explain": [
          "Diese Schaltung zeigt ein Zeitrelais mit zwei Kontaktarten:",
          "S1 = Start-Taster (Schliesser)",
          "K1 = Zeitrelais mit Spule + zwei Hilfskontakten",
          "K1-S = Sofortschaltend (S) - schliesst sofort mit der Spule",
          "K1-V = Einschaltverzoegert (V) - schliesst erst nach der eingestellten Zeit",
          "P1 = Lampe fuer Sofortschaltung",
          "P2 = Lampe fuer verzoegerte Schaltung"
        ],
        "voltagePoints": [
          { "point": "L", "value": "+24V" },
          { "point": "N", "value": "0V" }
        ]
      }
    ]
  }
}